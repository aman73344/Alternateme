{
  "name": "alternate-me-api",
  "version": "1.0.0",
  "private": true,
  "description": "Alternate Me - AI Digital Twin Platform API",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npx --yes tsx --tsconfig tsconfig.json src/index.ts",
    "build": "tsc",
    "start": "node -r module-alias/register dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "docker:build": "docker build -t alternate-me-api .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.45.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.0",
    "module-alias": "^2.2.3",
    "nodemailer": "^6.9.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/http-status": "^1.1.2",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
