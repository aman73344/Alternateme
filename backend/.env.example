# =============================================================================
# Alternate Me - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
API_VERSION=1.0.0
APP_NAME=Alternate Me API
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database (Neon PostgreSQL) --------------------------------------------
# DATABASE_URL should use the pooled connection (PgBouncer) for regular queries
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/alterneme?sslmode=require&pgbouncer=true
# DIRECT_URL must use the direct (non-pooled) connection for Prisma transactions
DIRECT_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/alterneme?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Redis (Upstash / self-hosted) -----------------------------------------
REDIS_URL=redis://default:password@localhost:6379
REDIS_PREFIX=altme

# --- JWT (Authentication - Phase 1) ----------------------------------------
JWT_ACCESS_SECRET=generate-a-random-64-char-secret-here
JWT_REFRESH_SECRET=generate-another-random-64-char-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- AI Providers ----------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# --- Voice (ElevenLabs / Cartesia) -----------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_MODEL=eleven_turbo_v2_5

CARTESIA_API_KEY=your-cartesia-key

# --- Telephony (Twilio) ----------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- Email (Resend / SMTP) -------------------------------------------------
RESEND_API_KEY=re_your-resend-key

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=noreply@alterneme.com

# --- Storage (AWS S3 / Cloudflare R2) --------------------------------------
# STORAGE_PROVIDER=auto  # auto | s3 | local (auto: S3 when real creds, else local disk)
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key
STORAGE_REGION=us-east-1
STORAGE_BUCKET=alterneme-uploads
STORAGE_ENDPOINT=  # Only for S3-compatible (R2, MinIO)
STORAGE_PUBLIC_URL=https://storage.alterneme.com
LOCAL_STORAGE_DIR=uploads

# --- Billing (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true

# --- Queue -----------------------------------------------------------------
QUEUE_CONCURRENCY=5
# Set to false to run without Redis/BullMQ (API stays up; jobs persist as
# QUEUED rows in ingestion_jobs and are not processed until re-enabled)
QUEUE_ENABLED=true

# --- Rate Limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Feature Flags ---------------------------------------------------------
FEATURE_VOICE_CLONING=false
FEATURE_TELEPHONY=false
FEATURE_EMAIL_AGENT=false
FEATURE_BYOK=false

# --- Analytics -------------------------------------------------------------
ANALYTICS_ENABLED=true
POSTHOG_API_KEY=phc_your-posthog-key

# --- Encryption ------------------------------------------------------------
ENCRYPTION_KEY=generate-a-32-byte-hex-key-here

# --- Knowledge Ingestion (Phase 3) ------------------------------------------
# Embedding provider: openai (production) | deterministic (tests/offline)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000

# Chunking (characters; token-aware heuristic used as upper bound)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_CHUNK_SIZE=2048
MIN_CHUNK_SIZE=64

# Limits (bytes)
MAX_FILE_SIZE=26214400          # 25 MB
MAX_DOCUMENT_SIZE=15728640      # 15 MB

# Safe URL ingestion
INGESTION_TIMEOUT=15000
MAX_URL_REDIRECTS=5
MAX_URL_RESPONSE_SIZE=5242880   # 5 MB
INGESTION_USER_AGENT=AlternateMeBot/1.0 (+https://alterneme.com)

# Retry policy
INGESTION_MAX_RETRIES=3

# Local object storage directory (when S3 is not configured)
LOCAL_STORAGE_DIR=uploads

# --- RAG Configuration (Phase 4) ------------------------------------------
# Number of candidates to retrieve initially from vector search
RAG_INITIAL_TOP_K=20
# Number of final chunks to include in context
RAG_FINAL_TOP_K=5
# Minimum similarity threshold (0-1, where 1 is identical)
RAG_MIN_SIMILARITY=0.7
# Maximum tokens for context sent to LLM
RAG_MAX_CONTEXT_TOKENS=3000
# Maximum chunks to include in context
RAG_MAX_CHUNKS=5
# Maximum characters for context
RAG_MAX_CHARACTERS=4000

# --- Chat Configuration (Phase 4) -----------------------------------------
# Maximum conversation messages to include in context
MAX_CONVERSATION_MESSAGES=10
# Maximum conversation tokens to include in context
MAX_CONVERSATION_TOKENS=2000
# Chat rate limiting
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30
# LLM timeout in milliseconds
LLM_TIMEOUT=60000
# Embedding timeout in milliseconds
EMBEDDING_TIMEOUT=30000
# Enable RAG debug endpoint (development only, set to false in production)
ENABLE_RAG_DEBUG=true
