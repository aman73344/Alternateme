# =============================================================================
# Alternate Me - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
API_VERSION=1.0.0
APP_NAME=Alternate Me API
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database (Neon PostgreSQL) --------------------------------------------
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/alterneme?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Redis (Upstash / self-hosted) -----------------------------------------
REDIS_URL=redis://default:password@localhost:6379
REDIS_PREFIX=altme

# --- JWT (Authentication - Phase 1) ----------------------------------------
JWT_ACCESS_SECRET=generate-a-random-64-char-secret-here
JWT_REFRESH_SECRET=generate-another-random-64-char-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- AI Providers ----------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# --- Voice (ElevenLabs / Cartesia) -----------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_MODEL=eleven_turbo_v2_5

CARTESIA_API_KEY=your-cartesia-key

# --- Telephony (Twilio) ----------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- Email (Resend / SMTP) -------------------------------------------------
RESEND_API_KEY=re_your-resend-key

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=noreply@alterneme.com

# --- Storage (AWS S3 / Cloudflare R2) --------------------------------------
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key
STORAGE_REGION=us-east-1
STORAGE_BUCKET=alterneme-uploads
STORAGE_ENDPOINT=  # Only for S3-compatible (R2, MinIO)
STORAGE_PUBLIC_URL=https://storage.alterneme.com

# --- Billing (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true

# --- Queue -----------------------------------------------------------------
QUEUE_CONCURRENCY=5

# --- Rate Limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Feature Flags ---------------------------------------------------------
FEATURE_VOICE_CLONING=false
FEATURE_TELEPHONY=false
FEATURE_EMAIL_AGENT=false
FEATURE_BYOK=false

# --- Analytics -------------------------------------------------------------
ANALYTICS_ENABLED=true
POSTHOG_API_KEY=phc_your-posthog-key

# --- Encryption ------------------------------------------------------------
ENCRYPTION_KEY=generate-a-32-byte-hex-key-here
