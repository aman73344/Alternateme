generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector, citext, and uuid-ossp extensions are expected but not required here
  // They will be installed manually if needed
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AlternateStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum AlternateVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum OnboardingStep {
  PERSONAL
  SOURCES
  PERSONA
  VOICE
  AI_PROVIDER
  PUBLISH
}

enum SourceType {
  FILE
  URL
  LINKEDIN
  YOUTUBE
  OTHER
}

enum SourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ConversationChannel {
  CHAT
  EMAIL
  VOICE
  TELEPHONY
  API
  WIDGET
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  EXPIRED
  TRIALING
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum ApiKeyType {
  PUBLIC
  PRIVATE
}

enum TrainingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum VoiceProvider {
  ELEVENLABS
  CARTESIA
  CUSTOM
}

enum VoiceType {
  PROVIDER_VOICE
  CLONED_VOICE
}

enum VoiceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AIProvider {
  OPENAI
  ANTHROPIC
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailStatus {
  DRAFT
  SENT
  FAILED
  DELIVERED
  OPENED
  CLICKED
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
}

enum AuditAction {
  ALTERNATE_CREATED
  ALTERNATE_UPDATED
  ALTERNATE_DELETED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETED
  SOURCE_ADDED
  SOURCE_DELETED
  PERSONA_UPDATED
  VOICE_SELECTED
  VOICE_CONSENT_GIVEN
  AI_PROVIDER_ADDED
  AI_PROVIDER_REMOVED
  ALTERNATE_PUBLISHED
}

// ===========================================================================
// CORE TABLES
// ===========================================================================

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String?  @db.Uuid
  username           String   @unique
  email              String   @unique
  emailVerified      DateTime?
  name               String?
  avatarUrl          String?
  role               UserRole @default(USER)
  passwordHash       String?
  isMfaEnabled       Boolean  @default(false)
  mfaSecret          String?
  bio                String?
  timezone           String?  @default("UTC")
  language           String?  @default("en")
  theme              String?  @default("light")
  lastLoginAt        DateTime?
  isActive           Boolean  @default(true)
  deletedAt          DateTime?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferences        UserPreference?
  sessions           Session[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts      OAuthAccount[]
  alternates         Alternate[]
  apiKeys            ApiKey[]
  subscriptions      Subscription[]
  conversations      Conversation[]
  usageRecords       UsageRecord[]
  voiceProfiles      VoiceProfile[]
  trainingJobs       TrainingJob[]
  emailThreads       EmailThread[]
  callRecords        CallRecord[]
  analytics          AnalyticEvent[]
  auditLogs          AuditLog[]
  trainingSources    TrainingSource[]
  onboardings        Onboarding[]
  personas           Persona[]
  aiProviderConfigs  AIProviderConfig[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("users")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  domain    String?  @unique
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  sessions Session[]
  auditLogs AuditLog[]

  @@index([slug])
  @@map("tenants")
}

model UserPreference {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @db.Uuid
  timezone               String   @default("UTC")
  language               String   @default("en")
  theme                  String   @default("light")
  notificationPreferences Json?    @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([timezone])
  @@index([language])
  @@index([theme])
  @@map("user_preferences")
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  tenantId      String?  @db.Uuid
  device        String?
  browser       String?
  os            String?
  ipAddress     String?
  country       String?
  city          String?
  userAgent     String?
  createdAt     DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  revokedAt     DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([tenantId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  sessionId       String   @db.Uuid
  tokenHash       String   @unique
  rotatedFromId   String?  @unique @db.Uuid
  replacedByToken String?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  ipAddress       String?
  userAgent       String?
  fingerprint     String?
  lastUsedAt      DateTime?
  isActive        Boolean  @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  previous RefreshToken? @relation("TokenRotation", fields: [rotatedFromId], references: [id])
  next     RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tokenHash   String   @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  scope             String?
  expiresAt         DateTime?
  tokenType         String?
  idToken           String?
  profile           Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@map("oauth_accounts")
}

// ===========================================================================
// ALTERNATES
// ===========================================================================

model Alternate {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @db.Uuid
  username         String              @unique
  displayName      String
  title            String?
  bio              String?
  avatarUrl        String?
  visibility       AlternateVisibility @default(PRIVATE)
  status           AlternateStatus     @default(DRAFT)
  personaPrompt    String?
  modelId          String?
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboarding    Onboarding?
  persona       Persona?
  sources       TrainingSource[]
  voiceProfile  VoiceProfile?
  aiProvider    AIProviderConfig?
  conversations Conversation[]
  trainingJobs  TrainingJob[]
  emailThreads  EmailThread[]
  callRecords   CallRecord[]
  chunks        ContentChunk[]

  @@index([userId])
  @@index([username])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@map("alternates")
}

// ===========================================================================
// ONBOARDING
// ===========================================================================

model Onboarding {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  alternateId    String           @unique @db.Uuid
  currentStep    OnboardingStep
  completedSteps OnboardingStep[]
  status         OnboardingStatus @default(NOT_STARTED)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alternateId])
  @@index([status])
  @@map("onboardings")
}

// ===========================================================================
// PERSONA
// ===========================================================================

model Persona {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  alternateId     String    @unique @db.Uuid
  tone            String?
  writingStyle    String?
  personality     String?
  instructions    String?   @db.Text
  boundaries      String?   @db.Text
  refusalBehavior String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alternateId])
  @@map("personas")
}

// ===========================================================================
// TRAINING & KNOWLEDGE
// ===========================================================================

model TrainingSource {
  id           String       @id @default(uuid()) @db.Uuid
  alternateId  String       @db.Uuid
  userId       String       @db.Uuid
  type         SourceType
  origin       String?
  name         String
  url          String?
  fileName     String?
  mimeType     String?
  fileSize     Int?
  status       SourceStatus @default(PENDING)
  wordCount    Int?
  errorMessage String?
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  alternate Alternate    @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks    ContentChunk[]

  @@index([alternateId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("training_sources")
}

model ContentChunk {
  id              String         @id @default(uuid()) @db.Uuid
  alternateId     String         @db.Uuid
  sourceId        String         @db.Uuid
  index           Int
  content         String         @db.Text
  metadata        Json?
  tokenCount      Int?
  // Embeddings stored externally (e.g., Pinecone, or pgvector extension installed manually)
  embeddingId     String?
  createdAt       DateTime       @default(now())

  alternate Alternate      @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  source    TrainingSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([alternateId])
  @@index([sourceId])
  @@map("content_chunks")
}

model TrainingJob {
  id            String         @id @default(uuid()) @db.Uuid
  alternateId   String         @db.Uuid
  userId        String         @db.Uuid
  status        TrainingStatus @default(QUEUED)
  progress      Int            @default(0)
  totalItems    Int            @default(0)
  processedItems Int           @default(0)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alternateId])
  @@index([userId])
  @@index([status])
  @@map("training_jobs")
}

// ===========================================================================
// VOICE
// ===========================================================================

model VoiceProfile {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  alternateId     String       @db.Uuid
  provider        VoiceProvider
  voiceId         String
  name            String
  type            VoiceType
  consentGiven    Boolean      @default(false)
  consentTimestamp DateTime?
  status          VoiceStatus  @default(PENDING)
  settings        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alternateId])
  @@unique([alternateId])
  @@map("voice_profiles")
}

// ===========================================================================
// AI PROVIDER CONFIG
// ===========================================================================

model AIProviderConfig {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  alternateId     String   @unique @db.Uuid
  provider        AIProvider
  encryptedApiKey String   @db.Text
  keyLabel        String?
  status          String   @default("PENDING")
  defaultModel    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastValidatedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alternateId])
  @@index([provider])
  @@map("ai_provider_configs")
}

// ===========================================================================
// CONVERSATIONS
// ===========================================================================

model Conversation {
  id            String               @id @default(uuid()) @db.Uuid
  alternateId   String               @db.Uuid
  userId        String               @db.Uuid
  channel       ConversationChannel  @default(CHAT)
  title         String?
  sessionId     String?
  metadata      Json?
  messageCount  Int                  @default(0)
  isActive      Boolean              @default(true)
  satisfaction  Int?
  feedback      String?
  startedAt     DateTime             @default(now())
  endedAt       DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([alternateId])
  @@index([userId])
  @@index([channel])
  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  tokensUsed     Int?
  modelUsed      String?
  latencyMs      Int?
  metadata       Json?
  sources        Json?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

// ===========================================================================
// EMAIL
// ===========================================================================

model EmailThread {
  id          String        @id @default(uuid()) @db.Uuid
  alternateId String        @db.Uuid
  userId      String        @db.Uuid
  subject     String
  fromEmail   String
  toEmail     String
  threadId    String?
  direction   EmailDirection @default(INBOUND)
  status      EmailStatus   @default(SENT)
  messageCount Int          @default(0)
  lastActivityAt DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  EmailMessage[]

  @@index([alternateId])
  @@index([userId])
  @@index([threadId])
  @@map("email_threads")
}

model EmailMessage {
  id         String        @id @default(uuid()) @db.Uuid
  threadId   String        @db.Uuid
  messageId  String?
  fromEmail  String
  toEmail    String
  subject    String
  body       String        @db.Text
  bodyHtml   String?       @db.Text
  status     EmailStatus   @default(SENT)
  metadata   Json?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("email_messages")
}

// ===========================================================================
// TELEPHONY
// ===========================================================================

model CallRecord {
  id            String     @id @default(uuid()) @db.Uuid
  alternateId   String     @db.Uuid
  userId        String     @db.Uuid
  twilioCallSid String?    @unique
  fromNumber    String
  toNumber      String
  direction     String
  status        CallStatus @default(INITIATED)
  duration      Int?
  cost          Decimal?   @db.Decimal(10, 4)
  recordingUrl  String?
  transcription String?    @db.Text
  metadata      Json?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alternateId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@map("call_records")
}

// ===========================================================================
// ANALYTICS
// ===========================================================================

model AnalyticEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  event     String
  properties Json?
  sessionId String?
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([event])
  @@index([timestamp])
  @@map("analytic_events")
}

// ===========================================================================
// AUDIT
// ===========================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tenantId    String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// API KEYS
// ===========================================================================

model ApiKey {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  name      String
  keyPrefix String
  keyHash   String     @unique
  type      ApiKeyType @default(PRIVATE)
  scopes    Json?
  lastUsedAt DateTime?
  expiresAt DateTime?
  isRevoked Boolean    @default(false)
  revokedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@index([isRevoked])
  @@map("api_keys")
}

// ===========================================================================
// BILLING
// ===========================================================================

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  stripeCustomerId  String?            @unique
  stripeSubscriptionId String?         @unique
  tier              SubscriptionTier   @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt       DateTime?
  canceledAt        DateTime?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  records UsageRecord[]

  @@index([userId])
  @@index([status])
  @@index([tier])
  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  subscriptionId String?  @db.Uuid
  feature        String
  quantity       Int      @default(1)
  unit           String   @default("count")
  metadata       Json?
  recordedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([feature])
  @@index([recordedAt])
  @@map("usage_records")
}