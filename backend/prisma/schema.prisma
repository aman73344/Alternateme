generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector, citext, uuid_ossp]
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AlternateStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum SourceType {
  DOCUMENT
  URL
  LINKEDIN
  YOUTUBE
  RESUME
  MANUAL
  WHATSAPP
}

enum SourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ConversationChannel {
  CHAT
  EMAIL
  VOICE
  TELEPHONY
  API
  WIDGET
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  EXPIRED
  TRIALING
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum ApiKeyType {
  PUBLIC
  PRIVATE
}

enum TrainingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum VoiceProvider {
  ELEVENLABS
  CARTESIA
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailStatus {
  DRAFT
  SENT
  FAILED
  DELIVERED
  OPENED
  CLICKED
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
}

// ===========================================================================
// CORE TABLES
// ===========================================================================

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  emailVerified  DateTime?
  name           String?
  avatarUrl      String?
  role           UserRole @default(USER)
  passwordHash   String?
  googleId       String?  @unique
  githubId       String?  @unique
  isMfaEnabled   Boolean  @default(false)
  mfaSecret      String?
  lastLoginAt    DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  alternates     Alternate[]
  apiKeys        ApiKey[]
  subscriptions  Subscription[]
  conversations  Conversation[]
  usageRecords   UsageRecord[]
  voiceProfiles  VoiceProfile[]
  trainingJobs   TrainingJob[]
  emailThreads   EmailThread[]
  callRecords    CallRecord[]
  analytics      AnalyticEvent[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Alternate {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  name        String
  slug        String          @unique
  description String?
  status      AlternateStatus @default(DRAFT)
  avatarUrl   String?
  persona     Json?
  voiceId     String?
  config      Json?
  publicUrl   String?         @unique
  isPublic    Boolean         @default(false)
  totalConversations Int     @default(0)
  totalMessages      Int     @default(0)
  lastActiveAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources       TrainingSource[]
  chunks        ContentChunk[]
  conversations Conversation[]
  voiceProfiles VoiceProfile[]
  trainingJobs  TrainingJob[]
  emailThreads  EmailThread[]
  callRecords   CallRecord[]

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("alternates")
}

// ===========================================================================
// TRAINING & KNOWLEDGE
// ===========================================================================

model TrainingSource {
  id           String       @id @default(uuid()) @db.Uuid
  alternateId  String       @db.Uuid
  userId       String       @db.Uuid
  type         SourceType
  status       SourceStatus @default(PENDING)
  title        String?
  description  String?
  url          String?
  fileUrl      String?
  fileType     String?
  fileSize     Int?
  rawContent   String?      @db.Text
  metadata     Json?
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  alternate Alternate    @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks    ContentChunk[]

  @@index([alternateId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("training_sources")
}

model ContentChunk {
  id              String         @id @default(uuid()) @db.Uuid
  alternateId     String         @db.Uuid
  sourceId        String         @db.Uuid
  index           Int
  content         String         @db.Text
  metadata        Json?
  tokenCount      Int?
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime       @default(now())

  alternate Alternate      @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  source    TrainingSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([alternateId])
  @@index([sourceId])
  @@index([alternateId, embedding], type: IvffloatList)
  @@map("content_chunks")
}

model TrainingJob {
  id            String         @id @default(uuid()) @db.Uuid
  alternateId   String         @db.Uuid
  userId        String         @db.Uuid
  status        TrainingStatus @default(QUEUED)
  progress      Int            @default(0)
  totalItems    Int            @default(0)
  processedItems Int           @default(0)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alternateId])
  @@index([userId])
  @@index([status])
  @@map("training_jobs")
}

// ===========================================================================
// CONVERSATIONS
// ===========================================================================

model Conversation {
  id            String               @id @default(uuid()) @db.Uuid
  alternateId   String               @db.Uuid
  userId        String               @db.Uuid
  channel       ConversationChannel  @default(CHAT)
  title         String?
  sessionId     String?
  metadata      Json?
  messageCount  Int                  @default(0)
  isActive      Boolean              @default(true)
  satisfaction  Int?
  feedback      String?
  startedAt     DateTime             @default(now())
  endedAt       DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([alternateId])
  @@index([userId])
  @@index([channel])
  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  tokensUsed     Int?
  modelUsed      String?
  latencyMs      Int?
  metadata       Json?
  sources        Json?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

// ===========================================================================
// VOICE
// ===========================================================================

model VoiceProfile {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  alternateId  String?       @db.Uuid
  provider     VoiceProvider @default(ELEVENLABS)
  providerVoiceId String?
  name         String
  description  String?
  sampleUrl    String?
  settings     Json?
  isCloned     Boolean       @default(false)
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  alternate Alternate? @relation(fields: [alternateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([alternateId])
  @@map("voice_profiles")
}

// ===========================================================================
// API KEYS
// ===========================================================================

model ApiKey {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  name      String
  keyPrefix String
  keyHash   String     @unique
  type      ApiKeyType @default(PRIVATE)
  scopes    Json?
  lastUsedAt DateTime?
  expiresAt DateTime?
  isRevoked Boolean    @default(false)
  revokedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@index([isRevoked])
  @@map("api_keys")
}

// ===========================================================================
// BILLING
// ===========================================================================

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  stripeCustomerId  String?            @unique
  stripeSubscriptionId String?         @unique
  tier              SubscriptionTier   @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt       DateTime?
  canceledAt        DateTime?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  records UsageRecord[]

  @@index([userId])
  @@index([status])
  @@index([tier])
  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  subscriptionId String?  @db.Uuid
  feature        String
  quantity       Int      @default(1)
  unit           String   @default("count")
  metadata       Json?
  recordedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([feature])
  @@index([recordedAt])
  @@map("usage_records")
}

// ===========================================================================
// EMAIL
// ===========================================================================

model EmailThread {
  id          String        @id @default(uuid()) @db.Uuid
  alternateId String        @db.Uuid
  userId      String        @db.Uuid
  subject     String
  fromEmail   String
  toEmail     String
  threadId    String?
  direction   EmailDirection @default(INBOUND)
  status      EmailStatus   @default(SENT)
  messageCount Int          @default(0)
  lastActivityAt DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  EmailMessage[]

  @@index([alternateId])
  @@index([userId])
  @@index([threadId])
  @@map("email_threads")
}

model EmailMessage {
  id         String        @id @default(uuid()) @db.Uuid
  threadId   String        @db.Uuid
  messageId  String?
  fromEmail  String
  toEmail    String
  subject    String
  body       String        @db.Text
  bodyHtml   String?       @db.Text
  status     EmailStatus   @default(SENT)
  metadata   Json?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("email_messages")
}

// ===========================================================================
// TELEPHONY
// ===========================================================================

model CallRecord {
  id            String     @id @default(uuid()) @db.Uuid
  alternateId   String     @db.Uuid
  userId        String     @db.Uuid
  twilioCallSid String?    @unique
  fromNumber    String
  toNumber      String
  direction     String
  status        CallStatus @default(INITIATED)
  duration      Int?
  cost          Decimal?   @db.Decimal(10, 4)
  recordingUrl  String?
  transcription String?    @db.Text
  metadata      Json?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  alternate Alternate @relation(fields: [alternateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alternateId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@map("call_records")
}

// ===========================================================================
// ANALYTICS
// ===========================================================================

model AnalyticEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  event     String
  properties Json?
  sessionId String?
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([event])
  @@index([timestamp])
  @@map("analytic_events")
}

// ===========================================================================
// AUDIT
// ===========================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  action      String
  entity      String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
